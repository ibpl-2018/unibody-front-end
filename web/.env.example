# Public URL of the Unibody API (browser calls it directly; CORS allows WEB_URL)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: URL the Next.js server uses to reach the API (e.g. an internal Docker hostname). Defaults to NEXT_PUBLIC_API_URL.
API_URL=http://localhost:4000
# Public site URL (canonical links, sharing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Unibody mobile — copy to .env.local and adjust.
# API base URL. On a simulator "localhost" works for iOS; the Android emulator needs http://10.0.2.2:4000.
# On a physical device use your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Web storefront (hosts the /pay/<orderNo> Razorpay checkout page used for online payments)
EXPO_PUBLIC_WEB_URL=http://localhost:3000

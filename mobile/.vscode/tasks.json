{
  // Reference device: iPhone 17 Pro Max. Run with ⇧⌘B (default build task) or Terminal → Run Task.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "iOS: run on iPhone 17 Pro Max",
      "type": "shell",
      "command": "./tools/run-ios.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "iOS: run on iPhone 17 Pro Max (Expo Go)",
      "type": "shell",
      "command": "./tools/run-ios.sh --go",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Android: run on emulator",
      "type": "shell",
      "command": "npx expo run:android",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
